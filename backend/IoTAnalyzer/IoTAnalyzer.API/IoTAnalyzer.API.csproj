            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\IoTAnalyzer.UseCases\IoTAnalyzer.UseCases.csproj" />
        <ProjectReference Include="..\IoTAnalyzer.Infrastructure\IoTAnalyzer.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
